/* secrets.h.example - Template for PetKit Gateway secrets.
 *
 * Copy to secrets.h and fill in your own values, or generate it from
 * config.json with tools/gen_secrets.py. secrets.h is gitignored; this
 * template must never contain real values.
 */
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID           "YourNetwork"
#define WIFI_PASS           "your-wifi-password"

/* Your fountain's BLE address, uppercase, colon-separated.
 * Find it by scanning for a device named "Eversweet ..." - see docs/secret.md */
#define PETKIT_MAC          "AA:BB:CC:DD:EE:FF"

/* Your fountain's 6-byte auth secret, FORWARD-PADDED to 8 bytes.
 * The device secret itself is 6 bytes (12 hex chars); CMD 86 expects 8, with
 * the two extra zero bytes at the FRONT. So a secret of 1a2b3c4d5e6f becomes
 * "00001a2b3c4d5e6f" here. How to obtain it: see docs/secret.md */
#define PETKIT_SECRET_HEX   "00001a2b3c4d5e6f"

#define TG_TOKEN            "123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
#define TG_CHAT_ID          "123456789"
#define TG_ENABLED          1

#define CONFIG_POLL_MINUTES          5
#define CONFIG_THIRST_HOURS          8
#define CONFIG_THIRST_ESCALATE_HOURS 12
#define CONFIG_NORMAL_GAP_MINUTES    416

/* INERT - kept only so the config plumbing stays valid. The day is closed
 * CONFIG_REPORT_SETTLE_MIN minutes after midnight and nowhere else. Setting
 * these does nothing; see the warning in core/petkit_core.c. */
#define CONFIG_REPORT_HOUR           0
#define CONFIG_REPORT_MIN            0

#define CONFIG_REPORT_SETTLE_MIN     3
#define CONFIG_TIMEZONE_OFFSET_HOURS 3

#endif /* SECRETS_H */
